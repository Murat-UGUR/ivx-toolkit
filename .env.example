# Copy to .env and load it in your shell (e.g. `set -a; source .env; set +a`).
# Never commit the real .env file.
IVX_HOST=ivx.example.local
IVX_USER=api_submitter
# Leave IVX_PASSWORD empty to be prompted interactively.
IVX_PASSWORD=
IVX_API_VERSION=v2.0.0
IVX_PORT=443
IVX_VERIFY_TLS=true
# IVX_CA_BUNDLE=/path/to/ivx-ca.pem
# IVX_CLIENT_TOKEN=
